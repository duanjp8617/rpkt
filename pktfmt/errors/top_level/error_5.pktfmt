%%
%%

packet Proto1 {
    header = [
        field_name1 = Field {
            bit = 8, 
        },
        field_name2 = Field {
            bit = 8, 
        }
    ]
}

packet Proto2 {
    header = [
        field_name1 = Field {
            bit = 8, 
        },
        field_name2 = Field {
            bit = 8, 
        }
    ],
    cond=(field_name1==3)
}

packet Proto3 {
    header = [
        field_name1 = Field {
            bit = 16,
        },
        field_name2 = Field {
            bit = 8, 
        }
    ],
    cond=(field_name1==3)
}

packet Proto4 {
    header = [
        field_name1 = Field {
            bit = 8, 
        },
        field_name2 = Field {
            bit = 8, 
        }
    ],
    cond=(field_name1==5)
}

group G1 = {
    members = [
        Proto2,
        Proto3,
    ]
}
